@@ -25,6 +27,32 @@ export async function requestScan(kind: "license" | "insurance", signal: AbortSi
   return result;
 }
 
+const titleCase = (value: string) => value.toLowerCase().replace(/\b[a-z]/g, letter => letter.toUpperCase());
+
+/**
+ * Form values from an optional renewal notice scan (TxDMV VTR-39-A). The notice
+ * only fills blanks (callers use fillBlank), so a license or insurance value, or
+ * anything the customer typed, always wins. The first listed owner is used for
+ * names; the notice has no model (only a body style), so the model stays manual.
+ */
+export function noticeFill(f: Record<string, string>) {
+  const owner = (f.owner_names || "").split("/")[0].trim().split(/\s+/).filter(Boolean);
+  const vin = (f.vehicle_vin || "").toUpperCase();
+  return {
+    personal: {
+      firstName: owner.length > 1 ? titleCase(owner[0]) : undefined,
+      lastName: owner.length > 1 ? titleCase(owner[owner.length - 1]) : undefined,
+      address: f.owner_street, city: f.owner_city, state: f.owner_state,
+      zip: f.owner_zip ? f.owner_zip.slice(0, 5) : undefined,
+    },
+    license: {
+      licensePlate: f.license_plate, vehicleYear: f.vehicle_year, vehicleMake: f.vehicle_make,
+      vin: /^[A-HJ-NPR-Z0-9]{17}$/.test(vin) ? vin : undefined,
+    },
+    insurance: { policyHolder: owner.length > 1 ? titleCase(owner.join(" ")) : undefined },
+  };
+}
