# Both keys must come from the SAME Stripe account and test environment.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_PUBLISHABLE_KEY

# S700 card reader = the primary payment method. Leave BOTH blank to use only the typed-card form.
# Real reader: register it in Stripe Dashboard > Terminal > Readers, then paste its Location id (tml_...).
STRIPE_LOCATION_ID=
# Stripe's built-in fake reader, for testing without hardware (1 = on). Takes priority over the location.
STRIPE_SIMULATED=0

# Monday.com CRM (one new row per finished renewal). NEVER share or commit the token.
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# Optional: the group new rows land in (python3 monday_service.py columns lists the ids)
MONDAY_GROUP_ID=

# Existing Pi .env camera settings take precedence. Full resolution is optional.
# KIOSK_CAMERA_WIDTH=4608
# KIOSK_CAMERA_HEIGHT=2592
# KIOSK_CAMERA_AUTOFOCUS=1
# KIOSK_CAMERA_LENS_POSITION=

# Insurance original images and OCR results are saved by default.
# KIOSK_INSURANCE_SAVE_DEBUG=1
# KIOSK_OCR_SECONDS=60
# Preserve runtime/payments.sqlite3 when replacing the project.
