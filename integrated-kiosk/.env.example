# Stripe TEST secret key (Dashboard > Developers > API keys, with Test mode on). No publishable key is needed.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY

# The physical S700 card reader is the only way to pay (no typed card, no simulator).
# Register the S700 in Stripe Dashboard > Terminal > Readers, then paste its Location id (tml_...). Required.
STRIPE_LOCATION_ID=
# Optional: the reader's id (tmr_...). Only needed if more than one physical reader is at that location.
STRIPE_READER_ID=

# Monday.com CRM (one new row per finished renewal). NEVER share or commit the token.
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# Optional: the group new rows land in (python3 monday_service_CG.py columns lists the ids)
MONDAY_GROUP_ID=
# Optional: Files columns for the security Pi's photos (python3 monday_service_CG.py columns lists the ids).
# A photo is only fetched from the security Pi and uploaded if its column is set.
MONDAY_SECURITY_LICENSE_COLUMN=
MONDAY_SECURITY_PAY_COLUMN=
MONDAY_SECURITY_PRINT_COLUMN=

# Existing Pi .env camera settings take precedence. Full resolution is optional.
# KIOSK_CAMERA_WIDTH=4608
# KIOSK_CAMERA_HEIGHT=2592
# KIOSK_CAMERA_AUTOFOCUS=1
# KIOSK_CAMERA_LENS_POSITION=

# Insurance original images and OCR results are saved by default.
# KIOSK_INSURANCE_SAVE_DEBUG=1
# KIOSK_OCR_SECONDS=60
# Preserve runtime/payments.sqlite3 when replacing the project.
